#!/bin/bash

# Minimize a window to Transom's taskbar.
# Usage: minimize [--keep-pointer] [window-address]   (the active window when given none)
#
# A copy of Omarchy's omarchy-hyprland-window-minimize without its
# "floating workspaces only" check: Omarchy's dock appears only on floating
# workspaces, but the taskbar is on every workspace. Like Omarchy's, it parks
# the window on special:minimized and tags it omarchy-minimized-from-<id>, so
# the taskbar of the workspace it came from can show it and bring it back.
# Super+M runs this, through the binding in the README (any key works).

# --keep-pointer (Transom's own clicks, unless its pointerToWindow is on):
# the move and the focus run as one Lua chunk inside Hyprland with its
# pointer moves off just for them, so the pointer stays where the user
# clicked. Without it (Super+M) Hyprland's own settings apply.
KEEP_POINTER=0
if [[ ${1:-} == --keep-pointer ]]; then
  KEEP_POINTER=1
  shift
fi

ACTIVE=$(hyprctl activewindow -j | jq -r '.address // empty')
if [[ -n ${1:-} ]]; then
  ADDRESS=$1
  [[ $ADDRESS == 0x* ]] || ADDRESS="0x$ADDRESS"
  [[ $ADDRESS =~ ^0x[0-9a-fA-F]+$ ]] || exit 1
  WORKSPACE=$(hyprctl clients -j | jq -r --arg address "$ADDRESS" 'first(.[] | select(.address == $address) | .workspace.id) // empty')
else
  read -r ADDRESS WORKSPACE < <(hyprctl activewindow -j | jq -r '"\(.address // "") \(.workspace.id // "")"')
fi

# Only windows on regular workspaces (positive ids): not already minimized,
# not on the scratchpad.
[[ -n $ADDRESS && $WORKSPACE =~ ^[0-9]+$ ]] || exit 1

remember_minimized_from() {
  local address=$1 workspace=$2 clients tag
  if clients=$(hyprctl clients -j); then
    while read -r tag; do
      [[ $tag =~ ^omarchy-minimized-from-[0-9]+$ && $tag != "omarchy-minimized-from-$workspace" ]] || continue
      hyprctl dispatch "hl.dsp.window.tag({ tag = \"-$tag\", window = \"address:$address\" })" >/dev/null
    done < <(jq -r --arg address "$address" '.[] | select(.address == $address) | (.tags // [])[]' <<<"$clients")
  fi
  # hyprctl exits 0 even when Hyprland refuses, so read its reply.
  [[ $(hyprctl dispatch "hl.dsp.window.tag({ tag = \"+omarchy-minimized-from-$workspace\", window = \"address:$address\" })") == ok ]]
}

# Without its tag a minimized window has no home workspace on the taskbar,
# so it isn't moved unless the tag landed.
remember_minimized_from "$ADDRESS" "$WORKSPACE" || exit 1

move="hl.dsp.window.move({ workspace = \"special:minimized\", follow = false, window = \"address:$ADDRESS\" })"
# Minimizing the focused window: focus would otherwise stay with it, and the
# next window opened would join it on the hidden workspace. Any other window
# (from a taskbar menu, or show desktop's chain): leave the screen where it
# is (strict review R1-M6).
focus=""
[[ $ADDRESS == "$ACTIVE" ]] && focus="hl.dsp.focus({ workspace = \"$WORKSPACE\" })"

if (( KEEP_POINTER )); then
  # The same chunk as Transom's TasksModel.dispatchChunk.
  steps="pcall(function() hl.dispatch($move) end)"
  [[ -n $focus ]] && steps+="; pcall(function() hl.dispatch($focus) end)"
  hyprctl repl "local w = hl.get_config(\"cursor.no_warps\"); local c = hl.get_config(\"cursor.warp_on_change_workspace\"); hl.config({ cursor = { no_warps = true, warp_on_change_workspace = 0 } }); $steps; hl.config({ cursor = { no_warps = w, warp_on_change_workspace = c } })" >/dev/null
else
  hyprctl dispatch "$move" >/dev/null
  [[ -n $focus ]] && hyprctl dispatch "$focus" >/dev/null
fi
exit 0
